{
  "permissions": {
    "deny": [
      "AskUserQuestion"
    ]
  },
  "enabledPlugins": {
    "portable@web-tools": false
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/build-on-commit.sh"
          }
        ]
      }
    ]
  }
}
