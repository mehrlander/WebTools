{
  "note": "The properties registry: the declaration table of docs/registries.md, binding scope x property to its one authoritative registry. Registries name their carrier, key field (structural identity, exempt from declaration), scope, and gate; declarations carry mode (recorded or computed, with the deriver for computed), required (what the gates enforce today: value, counted, or none), and the value domain where one is closed. Governed carriers are held both ways by tools/test/properties-registry.test.mjs: an undeclared row field fails, a declared property missing from the carrier fails, a computed declaration whose deriver does not exist fails. Origin: budget-drs data/design/properties.csv in mehrlander/home.",
  "registries": [
    {
      "id": "docs-census",
      "carrier": "docs/docs.json",
      "format": "json",
      "rows": "documents",
      "key": "path",
      "kind": "census",
      "scope": "every file under docs/",
      "gate": "tools/test/docs-registry.test.mjs"
    },
    {
      "id": "tests-census",
      "carrier": "docs/tests.json",
      "format": "json",
      "rows": "tests",
      "key": "path",
      "kind": "census",
      "scope": "every .mjs under tools/test/ except the declared shared helpers",
      "gate": "tools/test/tests-registry.test.mjs"
    },
    {
      "id": "harness-census",
      "carrier": "docs/harness.json",
      "format": "json",
      "rows": "tools",
      "key": "path",
      "kind": "census",
      "scope": "code files under tools/ and scripts/, except tools/test/, which the tests census owns",
      "gate": "tools/test/artifacts-lockstep.test.mjs"
    },
    {
      "id": "content-registry",
      "carrier": "data/design/content.csv",
      "format": "csv",
      "key": "locator",
      "kind": "catalog",
      "scope": "artifacts the registry curates; authoritative for what it covers, undeclared is a normal state",
      "gate": null
    },
    {
      "id": "portable-catalog",
      "carrier": "docs/portable.json",
      "format": "json",
      "rows": "items",
      "key": "path",
      "kind": "catalog",
      "scope": "what the hub ships to other repos",
      "gate": "tools/test/portable-manifest.test.mjs"
    },
    {
      "id": "tools-gallery",
      "carrier": "docs/tools.json",
      "format": "json",
      "rows": "items",
      "key": "path",
      "kind": "catalog",
      "scope": "utility pages curated into show-repo's Tools view",
      "gate": null
    }
  ],
  "declarations": [
    { "property": "subject", "registry": "docs-census", "mode": "recorded", "required": "none", "values": null,
      "gloss": "what the document is about, one line" },
    { "property": "status", "registry": "docs-census", "mode": "recorded", "required": "none",
      "values": ["living", "record", "measured"],
      "gloss": "whether the document is kept true, preserved as written, or derived from measurement" },
    { "property": "reach", "registry": "docs-census", "mode": "computed", "deriver": "tools/build/docs-reach.mjs", "required": "value",
      "values": ["injected", "project", "skill", "app", "orphan"],
      "gloss": "who can get to the document: injected at session start, reachable from project instructions, a skill, the app, or nothing" },
    { "property": "words", "registry": "docs-census", "mode": "computed", "deriver": "tools/build/docs-reach.mjs", "required": "value", "values": null,
      "gloss": "the document's size, and its share of the folder" },
    { "property": "maintenance", "registry": "docs-census", "mode": "recorded", "required": "counted", "values": null,
      "gloss": "who keeps the document true; a bare row is counted by the census rather than hidden" },

    { "property": "kind", "registry": "tests-census", "mode": "recorded", "required": "value",
      "values": ["behavior", "component", "kit", "tool", "gate", "lockstep", "guard"],
      "gloss": "the genre of check; the vocabulary is closed and the gate holds rows to it" },
    { "property": "protects", "registry": "tests-census", "mode": "recorded", "required": "counted", "values": null,
      "gloss": "the one thing that breaks if the test is deleted; blanks are counted" },
    { "property": "assertions", "registry": "tests-census", "mode": "computed", "deriver": "tools/build/tests-index.mjs", "required": "value", "values": null,
      "gloss": "top-level test() calls; null for a browser check, whose unit test() is not" },
    { "property": "method", "registry": "tests-census", "mode": "computed", "deriver": "tools/build/tests-index.mjs", "required": "value",
      "values": ["kit", "alpine", "spawn", "read", "pure"],
      "gloss": "how the check reaches its subject, strongest present wins" },
    { "property": "runner", "registry": "tests-census", "mode": "computed", "deriver": "tools/build/tests-index.mjs", "required": "value", "values": null,
      "gloss": "suite for a *.test.mjs file, else the npm script that runs it, else unrun" },
    { "property": "boot_smoke", "registry": "tests-census", "mode": "computed", "deriver": "tools/build/tests-index.mjs", "required": "value", "values": null,
      "gloss": "assertions that only check a component mounts" },

    { "property": "role", "registry": "harness-census", "mode": "recorded", "required": "counted", "values": null,
      "gloss": "what the file is for; blanks are counted rather than hidden" },
    { "property": "layer", "registry": "harness-census", "mode": "computed", "deriver": "tools/build/tools-index.mjs", "required": "value", "values": null,
      "gloss": "the file's folder, the rail's tree" },
    { "property": "lines", "registry": "harness-census", "mode": "computed", "deriver": "tools/build/tools-index.mjs", "required": "value", "values": null,
      "gloss": "file length" },
    { "property": "invocation", "registry": "harness-census", "mode": "computed", "deriver": "tools/build/tools-index.mjs", "required": "value", "values": null,
      "gloss": "how the file gets run: npm:<script>, driver, imported, argv, or none found (the warning state)" },
    { "property": "emits", "registry": "harness-census", "mode": "computed", "deriver": "tools/build/tools-index.mjs", "required": "value", "values": null,
      "gloss": "writes a file: a generator rather than a reader" },
    { "property": "named", "registry": "harness-census", "mode": "computed", "deriver": "tools/build/tools-index.mjs", "required": "value", "values": null,
      "gloss": "its path or basename appears in tracked prose" },
    { "property": "tested", "registry": "harness-census", "mode": "computed", "deriver": "tools/build/tools-index.mjs", "required": "value", "values": null,
      "gloss": "a file under tools/test/ exercises it" },

    { "property": "creation_mode", "registry": "content-registry", "mode": "recorded", "required": "none",
      "values": ["supplied", "mechanical", "human-authored", "model-authored", "hybrid-authored", "mixed"],
      "gloss": "what the artifact IS epistemically; the portable content-registry skill owns the convention" },
    { "property": "analysis_use", "registry": "content-registry", "mode": "recorded", "required": "none", "values": null,
      "gloss": "which corpora may draw on the artifact" },
    { "property": "description", "registry": "content-registry", "mode": "recorded", "required": "none", "values": null,
      "gloss": "one line on the artifact" },

    { "property": "kind", "registry": "portable-catalog", "mode": "recorded", "required": "value",
      "values": ["skill", "doc", "script", "dir"],
      "gloss": "what species of thing travels" },
    { "property": "command", "registry": "portable-catalog", "mode": "recorded", "required": "none", "values": null,
      "gloss": "the invocation name; present on kind:skill rows only" },
    { "property": "title", "registry": "portable-catalog", "mode": "recorded", "required": "none", "values": null,
      "gloss": "display name" },
    { "property": "role", "registry": "portable-catalog", "mode": "recorded", "required": "none", "values": null,
      "gloss": "what the item does for an adopting repo" },
    { "property": "use", "registry": "portable-catalog", "mode": "recorded", "required": "none", "values": null,
      "gloss": "when to reach for it" },

    { "property": "title", "registry": "tools-gallery", "mode": "recorded", "required": "none", "values": null,
      "gloss": "card title" },
    { "property": "note", "registry": "tools-gallery", "mode": "recorded", "required": "none", "values": null,
      "gloss": "one line under the card title" },
    { "property": "icon", "registry": "tools-gallery", "mode": "recorded", "required": "none", "values": null,
      "gloss": "phosphor icon name" }
  ]
}
